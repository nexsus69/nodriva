global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/realtime-alerts.yml

scrape_configs:
  - job_name: dashboard-web-realtime
    metrics_path: /api/internal/realtime/metrics
    authorization:
      type: Bearer
      credentials: "__REALTIME_WORKER_SECRET__"
    static_configs:
      - targets: ["__REALTIME_METRICS_TARGET__"]
  - job_name: dashboard-web-workflow
    metrics_path: /api/internal/workflows/metrics
    authorization:
      type: Bearer
      credentials: "__REALTIME_WORKER_SECRET__"
    static_configs:
      - targets: ["__REALTIME_METRICS_TARGET__"]
