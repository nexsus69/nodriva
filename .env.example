# Example application configuration. Copy outside the repository and replace
# every placeholder. This file is not a production deployment prescription.

# Choose exactly one persistence profile. Persistence is always required.
DATABASE_ADAPTER=sqlite
SQLITE_DATABASE_PATH=./.data/nodriva.sqlite
# For an operator-managed PostgreSQL deployment, replace the two lines above:
# DATABASE_ADAPTER=postgres
# DATABASE_URL=postgresql://nodriva_app:replace-me@db.example.test:5432/nodriva?sslmode=require
# REQUIRE_RESTRICTED_DB_ROLE=true

NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

ATTACHMENTS_ROOT=./.data/attachments
ATTACHMENTS_REQUIRE_ENCRYPTION=true
ATTACHMENTS_ENCRYPTION_KEY=replace-with-64-hex-characters
FIELD_ENCRYPTION_KEY=replace-with-64-hex-characters
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Optional integrations are disabled when their deployment values are absent.
NEXT_PUBLIC_REALTIME_ENABLED=false
ATTACHMENTS_REQUIRE_SCAN=false
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# BACKUP_ROOT=
# BACKUP_STATUS_FILE=
# PROMETHEUS_ENDPOINT=
