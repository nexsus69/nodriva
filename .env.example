# Example application configuration.
# Copy this file to .env and configure the values for your deployment.

# ==============================================================================
# 1. PERSISTENCE PROFILE (Choose exactly ONE: SQLite or PostgreSQL)
# ==============================================================================

# --- Profile A: Standalone SQLite (Default - Node.js + local file, zero external services) ---
DATABASE_ADAPTER=sqlite
SQLITE_DATABASE_PATH=./data/dashboard.sqlite

# --- Profile B: PostgreSQL (Uncomment and replace the lines above to use PostgreSQL) ---
# DATABASE_ADAPTER=postgres
# DATABASE_URL=postgresql://nodriva_app:your_password@localhost:5432/dashboard?sslmode=disable
# REQUIRE_RESTRICTED_DB_ROLE=true

# ==============================================================================
# 2. APPLICATION CORE & AUTHENTICATION (Required)
# ==============================================================================
# Public URL used for sessions, redirects and absolute URLs
NEXTAUTH_URL=http://127.0.0.1:3000

# Random secret for NextAuth JWT session encryption (at least 32 characters)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters

# Initial administrative bootstrap credentials
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-with-a-strong-password-min-12-chars

# Idle session sliding timeout in seconds (default: 1800 = 30 minutes)
# NEXT_PUBLIC_SESSION_IDLE_TIMEOUT_SECONDS=1800

# ==============================================================================
# 3. ENCRYPTION AT REST (Required for attachments and protected data fields)
# ==============================================================================
# Attachment storage location on filesystem
ATTACHMENTS_ROOT=./data/attachments
ATTACHMENTS_REQUIRE_ENCRYPTION=true

# 32-byte hexadecimal AES-256-GCM encryption keys (generate with: openssl rand -hex 32)
ATTACHMENTS_ENCRYPTION_KEY=replace-with-64-hex-characters
FIELD_ENCRYPTION_KEY=replace-with-64-hex-characters

# Base64-encoded 32-byte key for MFA TOTP secrets (generate with: openssl rand -base64 32)
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Optional key rotation keyring specs (format: v1=<64hex>,v2=<64hex>)
# ATTACHMENTS_ENCRYPTION_KEYS=v1=...,v2=...
# ATTACHMENTS_ENCRYPTION_ACTIVE_VERSION=v2
# FIELD_ENCRYPTION_KEYS=v1=...,v2=...
# FIELD_ENCRYPTION_ACTIVE_VERSION=v2

# ==============================================================================
# 4. OPTIONAL INTEGRATIONS (Disabled by default if variables are absent)
# ==============================================================================

# --- Realtime WebSocket (Pusher / Soketi) ---
NEXT_PUBLIC_REALTIME_ENABLED=false
# NEXT_PUBLIC_PUSHER_KEY=dashboard-app-key
# NEXT_PUBLIC_PUSHER_CLUSTER=mt1
# NEXT_PUBLIC_PUSHER_HOST=127.0.0.1
# NEXT_PUBLIC_PUSHER_PORT=6001
# NEXT_PUBLIC_PUSHER_SCHEME=http
# PUSHER_APP_ID=dashboard
# PUSHER_SECRET=replace-with-pusher-secret
# REALTIME_INTERNAL_HOST=127.0.0.1
# REALTIME_INTERNAL_PORT=6001
# REALTIME_INTERNAL_SCHEME=http
# REALTIME_WORKER_SECRET=replace-with-internal-worker-secret

# --- Attachment Antivirus (ClamAV daemon) ---
ATTACHMENTS_REQUIRE_SCAN=false
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000

# --- Account Actions / Invitation Delivery (Webhook) ---
# ACCOUNT_ACTION_DELIVERY_WEBHOOK_URL=https://api.mailservice.example.test/deliver
# ACCOUNT_ACTION_DELIVERY_WEBHOOK_SECRET=replace-with-webhook-secret
# ACCOUNT_ACTION_PUBLIC_BASE_URL=http://127.0.0.1:3000
# ACCOUNT_ACTION_ENCRYPTION_KEY=replace-with-64-hex-characters

# --- Observability & Backups ---
# BACKUP_ROOT=./var/backups
# BACKUP_STATUS_FILE=./var/backups/last-status.json
# PROMETHEUS_ENDPOINT=http://127.0.0.1:9090

# --- Local Development Origin (if accessing dev server from LAN) ---
# ALLOWED_DEV_ORIGINS=192.168.1.100
